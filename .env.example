# Copy to .env. Everything is optional: locally, Vertex AI uses your gcloud credentials
# (gcloud auth application-default login); on Cloud Run it uses the service's project.
# GOOGLE_CLOUD_PROJECT=your-project-id
# VERTEX_LOCATION=global
# MODEL=vertex_ai/gemini-3.5-flash
# RESEARCHER_MODEL=vertex_ai/gemini-3.5-flash-lite
# Optional: a free Socrata app token raises data.ny.gov rate limits for the MTA tool.
# SOCRATA_APP_TOKEN=
